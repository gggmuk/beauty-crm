# ==========================================
# BeautyCRM / BotBuilder SaaS Configuration
# ==========================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://beautycrm:beautycrm_secret@postgres:5432/beautycrm
DATABASE_URL_SYNC=postgresql://beautycrm:beautycrm_secret@postgres:5432/beautycrm

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Security ----
SECRET_KEY=change-me-to-a-random-64-char-string
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key-00112233445566778899aabbccddeeff
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://yourdomain.com/payment/success
STRIPE_CANCEL_URL=https://yourdomain.com/payment/cancel

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your-platform-bot-token
SUPERADMIN_TELEGRAM_ID=123456789
WEBHOOK_BASE_URL=https://yourdomain.com

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- App ----
APP_NAME=BeautyCRM
APP_ENV=development
SLOT_LOCK_TTL_SECONDS=600
